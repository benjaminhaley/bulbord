require 'securerandom'

default_platform(:ios)

# Certificate ID of the durable "iOS Distribution: Benjamin Haley" cert,
# created once and stored as the IOS_DIST_CERT_P12_BASE64/
# IOS_DIST_CERT_PASSWORD secrets (see the import step below). Not a secret
# itself — Apple shows it in the dashboard — just needed so
# get_provisioning_profile binds the profile to the same certificate the
# imported .p12 actually is, rather than guessing.
#
# If this ever needs regenerating: export the .p12 with OpenSSL 3.x's
# `-legacy` flag (`openssl pkcs12 -export -legacy ...`). Without it, OpenSSL
# defaults to AES-256/PBKDF2, which macOS's Keychain import API doesn't
# understand and fails with a misleading "MAC verification failed (wrong
# password?)" — even with the correct password. `-legacy` produces the
# older SHA1/RC2/3DES format Keychain actually expects.
DIST_CERT_ID = '9FX735J7PT'

platform :ios do
  desc 'Build the WebView-shell app and upload a new build to TestFlight'
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_CONTENT'],
      is_key_content_base64: false,
    )

    # Every CI run is a brand-new machine with no local keychain state, so
    # fastlane's own get_certificates (which only reuses a cert already
    # installed locally) would mint a fresh Distribution certificate on
    # every single run — and Apple caps how many can be active at once, so
    # a handful of runs exhausts the account's quota (this actually
    # happened). Import one durable cert instead, generated once outside CI
    # and stored as a secret — the same underlying problem `match` solves
    # with a git-backed store, without standing up a separate certs repo.
    keychain_name = 'bulbord-ci.keychain-db'
    keychain_password = SecureRandom.uuid

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
    )

    import_certificate(
      certificate_path: ENV['IOS_DIST_CERT_P12_PATH'],
      certificate_password: ENV['IOS_DIST_CERT_PASSWORD'],
      keychain_name: keychain_name,
      keychain_password: keychain_password,
    )

    # Not a bundled fastlane action (despite the name suggesting otherwise) —
    # this is the same raw `security` invocation match's own internals use
    # to let codesign access the imported key without a UI permission
    # prompt (which would hang non-interactively in CI).
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{keychain_password}' '#{keychain_name}'")

    get_provisioning_profile(api_key: api_key, app_identifier: 'com.bulbord.app', cert_id: DIST_CERT_ID)

    # The Xcode project has never been opened with a real signing team
    # configured (no Xcode in this codebase's dev/CI environment until now —
    # see CLAUDE.md's Platform strategy) — its default is automatic signing
    # with no team, which fails outright. Point it at the cert/profile the
    # two steps above just fetched.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: 'App.xcodeproj',
      team_id: ENV['FASTLANE_TEAM_ID'],
      code_sign_identity: 'iPhone Distribution',
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ['App'],
    )

    build_app(
      project: 'App.xcodeproj',
      scheme: 'App',
      export_method: 'app-store',
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
