{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "events:seed": "tsx src/events/seed-2026-07-29.ts",
    "events:refine-sources": "tsx src/events/update-2026-07-29-refine-sources.ts",
    "newsletter:send": "tsx src/newsletter/send-weekly.ts",
    "camp-reminders:send": "tsx src/camp-reminders/send-due.ts",
    "events:resource": "tsx src/events/sourcing-cron.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1100.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@simplewebauthn/server": "^13.3.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "postgres": "^3.4.9",
    "resend": "^6.18.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.31.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
