DATABASE_URL=postgres://campy:campy@localhost:5432/campy_dev
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Frontend origin, used to build the post-login redirect
WEB_URL=http://localhost:5173

# Random secret used to sign the OAuth `state` param; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Facebook Login app credentials (developers.facebook.com/apps)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# Stopgap admin login (POST /auth/password-login) while Facebook OAuth is
# unavailable — see CLAUDE.md, Login section. Leave unset to disable the route
# entirely (returns 503). Generate with the same command as SESSION_SECRET.
ADMIN_LOGIN_PASSWORD=

# Railway object storage bucket, for feedback screenshots and event images.
# Get credentials with:
#   railway bucket credentials --bucket uploads --environment production --json
UPLOADS_BUCKET=
UPLOADS_ACCESS_KEY_ID=
UPLOADS_SECRET_ACCESS_KEY=
UPLOADS_ENDPOINT=
UPLOADS_REGION=auto
# Prefix every object key with this (e.g. "dev/") so local/dev uploads never
# collide with production objects in the same bucket. Leave unset in production.
UPLOADS_KEY_PREFIX=
