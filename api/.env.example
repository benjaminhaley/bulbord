DATABASE_URL=postgres://bulbord:bulbord@localhost:5432/bulbord_dev
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Random secret used to sign the WebAuthn challenge token; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# WebAuthn (passkey) relying-party identity — see CLAUDE.md, Login section.
# RP_ID must be a bare domain (no scheme/port); ORIGIN is the exact page
# origin(s) passkey ceremonies are allowed from, comma-separated (a native
# app adds its own origin here once Capacitor is wired up — see Platform
# strategy).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Nettlehorst
WEBAUTHN_ORIGIN=http://localhost:5173

# Lets a registration happen with no inviter — used exactly once per person
# who needs to bootstrap in without an existing member (Ben's own first
# account; see CLAUDE.md, Login section). Leave unset to disable entirely.
# Generate with the same command as SESSION_SECRET.
ROOT_INVITE_SECRET=

# Railway object storage bucket, for feedback screenshots and event images.
# Get credentials with:
#   railway bucket credentials --bucket uploads --environment production --json
UPLOADS_BUCKET=
UPLOADS_ACCESS_KEY_ID=
UPLOADS_SECRET_ACCESS_KEY=
UPLOADS_ENDPOINT=
UPLOADS_REGION=auto
# Prefix every object key with this (e.g. "dev/") so local/dev uploads never
# collide with production objects in the same bucket. Leave unset in production.
UPLOADS_KEY_PREFIX=

# Optional: powers every Claude-backed feature in this codebase — simplifies
# verbose scraped event titles during ingestion (title-normalization.ts),
# the admin "re-run event sourcing" tool (resourcing.ts), and photo-to-listing
# extraction (photo-extraction.ts, feedback #93). Get a key at
# console.anthropic.com. Leave unset to skip gracefully feature-by-feature —
# titles ingest unchanged, re-sourcing finds nothing, photo extraction fails
# with a "couldn't read that, fill it in yourself" response — rather than any
# of them blocking on a missing key.
ANTHROPIC_API_KEY=

# Resend account for the weekly events newsletter (api/src/newsletter/) —
# get an API key at resend.com. FROM_EMAIL's sending domain must be verified
# in Resend's dashboard first (e.g. "Nettelhorst <nettelhorst.newsletter@bulbord.com>").
# Unlike ANTHROPIC_API_KEY below, mailer.ts reads these at module load and
# throws if either is empty — the server won't boot at all without *some*
# value here, even locally. A fake placeholder is enough to start the
# server; an actual test send will just fail against the real Resend API.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Absolute base URLs the newsletter uses to build links that work outside
# the app (email clients have no relative-URL/localStorage context) — the
# API's own public origin for image URLs, and the web app's public origin
# for event/unsubscribe links. Same values as VITE_API_URL / the web app's
# own origin, just needed server-side too.
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:5173

# App Store Connect API credentials — not read by the running application
# at all; stored here (and as real Railway env vars on the api service in
# production) purely as a durable, checkable-into-nothing place for these
# operational secrets to live, so a future session can check on an iOS
# submission's status without needing this conversation's memory. See
# CLAUDE.md's Platform strategy ("Checking review status in a future
# session") and api/src/ops/generate-asc-jwt.ts. Get a key at App Store
# Connect > Users and Access > Integrations > App Store Connect API.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=
