DATABASE_URL=postgres://campy:campy@localhost:5432/campy_dev
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Random secret used to sign the WebAuthn challenge token; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# WebAuthn (passkey) relying-party identity — see CLAUDE.md, Login section.
# RP_ID must be a bare domain (no scheme/port); ORIGIN is the exact page
# origin(s) passkey ceremonies are allowed from, comma-separated (a native
# app adds its own origin here once Capacitor is wired up — see Platform
# strategy).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Campy
WEBAUTHN_ORIGIN=http://localhost:5173

# Lets a registration happen with no inviter — used exactly once per person
# who needs to bootstrap in without an existing member (Ben's own first
# account; see CLAUDE.md, Login section). Leave unset to disable entirely.
# Generate with the same command as SESSION_SECRET.
ROOT_INVITE_SECRET=

# Railway object storage bucket, for feedback screenshots and event images.
# Get credentials with:
#   railway bucket credentials --bucket uploads --environment production --json
UPLOADS_BUCKET=
UPLOADS_ACCESS_KEY_ID=
UPLOADS_SECRET_ACCESS_KEY=
UPLOADS_ENDPOINT=
UPLOADS_REGION=auto
# Prefix every object key with this (e.g. "dev/") so local/dev uploads never
# collide with production objects in the same bucket. Leave unset in production.
UPLOADS_KEY_PREFIX=
